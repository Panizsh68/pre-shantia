# Safe production variable inventory. Replace every placeholder outside Git.
NODE_ENV=production
MONGO_URL=mongodb://admin:replace-with-runtime-password@mongo-primary:27017/test?replicaSet=rs0&authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-runtime-secret
ENCRYPTION_KEY=replace-with-a-random-32-character-secret
JWT_ACCESS_SECRET=replace-with-a-random-32-character-secret
JWT_REFRESH_SECRET=replace-with-a-random-32-character-secret
JWT_SECRET_KEY=replace-with-a-random-32-character-secret
PAYMENT_CALLBACK_SECRET=replace-with-a-random-32-character-secret
ENABLE_SWAGGER=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
HEALTH_READINESS_TOKEN=replace-with-a-random-32-character-secret
LOG_LEVEL=info
ZIBAL_MERCHANT_ID=replace-with-production-merchant-id
ZIBAL_SANDBOX=false
ZIBAL_CALLBACK_URL=https://example.invalid/api/payment/callback
ZIBAL_SECRET_KEY=replace-with-production-zibal-secret
ZIBAL_LOG_LEVEL=2
APP_URL=https://example.invalid
OTP_TTL=300
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
KAVENEGAR_SENDER=
SHAHKAR_BASE_URL=https://provider.example.invalid/verify
SHAHKAR_API_KEY=replace-with-provider-api-key
MOCK_PROVIDERS_ENABLED=false
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PHONE_MAX=3
RATE_LIMIT_OTP_REQUEST_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_REQUEST_IP_MAX=10
RATE_LIMIT_OTP_REQUEST_IP_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_PUBLIC_FORM_MAX=5
RATE_LIMIT_PUBLIC_FORM_WINDOW_SECONDS=3600
RATE_LIMIT_PAYMENT_MAX=10
RATE_LIMIT_PAYMENT_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=900
SUPERADMIN_MELICODE=
SUPERADMIN_PHONE=
R2_ENDPOINT=
