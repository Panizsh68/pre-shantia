# Example env for project (no secrets)
# Copy this to .env and fill values for local development or CI.

NODE_ENV=development
MONGO_URL=mongodb://localhost:27017/pre-shantia
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OTP_TTL=300
ENCRYPTION_KEY=your_encryption_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Kavenegar (SMS)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
KAVENEGAR_SENDER=10004346

# R2/S3
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

APP_URL=http://localhost:3000
