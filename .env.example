# Example env for project (no secrets)
# Copy this to .env and fill values for local development or CI.

NODE_ENV=development
OTP_DEBUG_LOGS=true
MONGO_URL=mongodb://localhost:27017/pre-shantia
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OTP_TTL=300
ENCRYPTION_KEY=your_encryption_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Kavenegar (SMS)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
KAVENEGAR_SENDER=10004346
SHAHKAR_BASE_URL=
SHAHKAR_API_KEY=
MOCK_PROVIDERS_ENABLED=true
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PHONE_MAX=3
RATE_LIMIT_OTP_REQUEST_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_REQUEST_IP_MAX=10
RATE_LIMIT_OTP_REQUEST_IP_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_PUBLIC_FORM_MAX=5
RATE_LIMIT_PUBLIC_FORM_WINDOW_SECONDS=3600
RATE_LIMIT_PAYMENT_MAX=10
RATE_LIMIT_PAYMENT_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=900

# R2/S3
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

APP_URL=http://localhost:3001
PAYMENT_CALLBACK_SECRET=use-a-fake-local-value-at-least-32-characters
ENABLE_SWAGGER=true
SWAGGER_USERNAME=developer
SWAGGER_PASSWORD=use-a-local-development-password
HEALTH_READINESS_TOKEN=use-a-fake-local-value-at-least-32-characters
LOG_LEVEL=debug
